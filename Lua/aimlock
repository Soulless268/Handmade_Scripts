local function sampleTrajectory(part, totalTime, dt)
	local samples = {}
	if dt <= 0 then return samples end
	local steps = math.floor(totalTime / dt)
	local pos0 = part.Position
	local v0 = part.AssemblyLinearVelocity
	local g = Vector3.new(0, -workspace.Gravity, 0)

	for i = 1, steps do
		local t = i * dt
		local pos = pos0 + v0 * t + 0.5 * g * t * t
		table.insert(samples, pos)
	end
	return samples
end

local function drawTrajectory(part)
	-- Example usage:
	-- local points = sampleTrajectory(somePart, 2, 0.05) -- positions for 0->2s every 0.05s
	local points = sampleTrajectory(part, totalTime_prediction, dt_prediction)
	-- remove old markers (simple approach)
	for _, p in ipairs(workspace:GetChildren()) do
		if p.Name == "TrajMarker" then p:Destroy() end
	end
	for i, pos in ipairs(points) do
		local m = Instance.new("Part")
		m.Size = Vector3.new(0.2,0.2,0.2)
		m.Anchored = true
		m.CanCollide = false
		m.Position = pos
		m.Name = "TrajMarker"
		m.Parent = workspace
	end
end

local function finding_(mousePos, children)
	local target_in_sight = {}
	for i,enemy in pairs(children) do
		if enemy == char then continue end
		if enemy:FindFirstChild(targetpart) then
			local enemypos = enemy[targetpart].CFrame.Position

			local screenPos, onScreen = cam:WorldToViewportPoint(enemypos)
			if onScreen then
				local dist = (Vector2.new(mousePos.X, mousePos.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
				if dist <= radiustext._value then
					table.insert(target_in_sight, enemy)
				elseif targetenemy == enemy and dist >= radiustext._value then
					targetenemy = nil
				end
			elseif targetenemy == enemy and not onScreen then
				targetenemy = nil
			end
		end
	end

	if next(target_in_sight) == nil then return end

	local function get_enemy(enemy)
		local enemyPos = enemy[targetpart].CFrame.Position
		local playerPos = if char.PrimaryPart then char.PrimaryPart.CFrame.Position else hrp.CFrame.Position

		if not DetectThroughWall._value then
			local ray_param = RaycastParams.new()
			ray_param.FilterType = Enum.RaycastFilterType.Exclude
			ray_param.FilterDescendantsInstances = {char, enemy}
			local raycast = workspace:Raycast(playerPos, enemyPos, ray_param)
			if raycast then warn("target have wall in bewtween | ", raycast.Instance) return end
		end

		local enemyplr = players:GetPlayerFromCharacter(enemy)
		if enemyplr and LockPlayer._value then
			if not LockTeam._value and enemyplr.Team == plr.Team then return end
			if table.find(ignore_players, enemyplr.Name) then return end
			targetenemy = enemy
			return targetenemy
		elseif not enemyplr and LockNPC._value then
			targetenemy = enemy
			return targetenemy
		end
	end

	if LockNearestEnemy._value then
		local nearest = nil
		local nearestDistance = math.huge

		for _,enemy in pairs(target_in_sight) do
			local enemyPos = enemy[targetpart].CFrame.Position
			local playerPos = if char.PrimaryPart then char.PrimaryPart.CFrame.Position else hrp.CFrame.Position
			local distance = (enemyPos - playerPos).Magnitude

			if distance < nearestDistance then
				nearestDistance = distance
				nearest = enemy
			end
		end

		if nearest then
			get_enemy(nearest)
		end

	else
		for _,enemy in pairs(target_in_sight) do
			if get_enemy(enemy) then break end
		end		
	end

	target_in_sight = {}

end

function lockon()
	if not targetenemy then return end
	local enemypos = targetenemy[targetpart].CFrame.Position
	local hum = targetenemy.Humanoid :: Humanoid
	local pos = cam.CFrame.Position
	local target = CFrame.new(pos, enemypos)

	local function pan_cam(pos)
		if aimlock_smoothness_text._value <= 0 then
			cam.CFrame = target
		else
			local alpha = 1 / (aimlock_smoothness_text._value * 2 + 1) --alternative
			--local alpha = math.exp(-aimlock_smoothness_text._value) --alternative
			-- local alpha = 1 / (aimlock_smoothness_text._value + 1)  --main
			cam.CFrame = cam.CFrame:Lerp(target, alpha)
		end
	end

	if PredictMovement._value and hum then
		local vel = targetenemy[targetpart].AssemblyLinearVelocity
		local predict_pos = enemypos + vel * dt_prediction
		pan_cam(CFrame.new(pos, predict_pos))
	else
		pan_cam(target)
	end
end

