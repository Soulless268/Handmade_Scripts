	end
	
	new.Name = "HighlightYOOitAIMHIGHLIGHT"
	new.Adornee = adornee
	new.Parent = parent or highlight_folder
	highlights_store[adornee] = new

	local real_parent = new.Parent

	task.spawn(function()
		if isplr and not adornee:FindFirstChild('Head') then
			repeat task.wait(.1) until adornee:FindFirstChild('Head')
		end
		if isplr and adornee:FindFirstChild("Head") and highlights_store[adornee] then
			local BillboardGui = Instance.new("BillboardGui")
			local TextLabel = Instance.new("TextLabel")

			if ShowEspStatsButton._value then
				BillboardGui.Adornee = adornee.Head
				BillboardGui.Name = isplr.Name
				BillboardGui.Parent = new
				BillboardGui.Size = UDim2.new(0, 100, 0, 150)
				BillboardGui.StudsOffset = Vector3.new(0, 1, 0)
				BillboardGui.AlwaysOnTop = true
				TextLabel.Parent = BillboardGui
				TextLabel.BackgroundTransparency = 1
				TextLabel.Position = UDim2.new(0, 0, 0, -50)
				TextLabel.Size = UDim2.new(0, 100, 0, 100)
				TextLabel.Font = Enum.Font.SourceSansSemibold
				TextLabel.TextSize = 20
				TextLabel.TextColor3 = Color3.new(1, 1, 1)
				TextLabel.TextStrokeTransparency = 0
				TextLabel.TextYAlignment = Enum.TextYAlignment.Bottom
				TextLabel.Text = 'Name: '..isplr.Name
				TextLabel.ZIndex = 10
			else
				BillboardGui:Destroy()
				TextLabel:Destroy()
			end

			local espLoopFunc

			local function espLoop()
