hub._runners.runner_main = rs.RenderStepped:Connect(function()
	if not targetenemy 
		or not (targetenemy:IsDescendantOf(child_table.plr_folder.path) or targetenemy:IsDescendantOf(child_table.npc_folder.path))
		or (targetenemy.Humanoid:GetState() == Enum.HumanoidStateType.Dead and not lockafterdeadbutton._value) then
		targetenemy = nil
	end

	if not hub._enable then return end

	if targetenemy == nil then
		AimLock()
	elseif targetenemy and LockNearestEnemy._value then
		AimLock()
	end

end)

hub._runners.runner_mouse = plr_mouse.Move:Connect(function()
	task.spawn(function()
		local x,y = getMousePosition()
		radius.Position = UDim2.new(0, x, 0, y) - UDim2.new(
			radius.Size.X.Scale / 2, radius.Size.X.Offset / 2,
			radius.Size.Y.Scale / 2, radius.Size.Y.Offset / 2
		)
	end)
end)

hub._runners.runner_lockon = rs.RenderStepped:Connect(function()
	if targetenemy and (targetenemy:IsDescendantOf(child_table.plr_folder.path) or targetenemy:IsDescendantOf(child_table.npc_folder.path)) then
		lockon()
	end
end)

local delay_t = 10 -- second
local rpl = 10
local previous_rpl = nil
local rnl = 10
local previous_rnl = nil
hub._runners.runner_players_list = rs.RenderStepped:Connect(function(dt)
	rpl += dt
	if (previous_rpl and previous_rpl == #child_table.plr_folder.childs) or rpl < delay_t then return end
	rpl = 0

	for _,v in pairs(hub._catagories["Players List"]._main_f:GetChildren()) do
		if not v:IsA("TextLabel") then continue end
		v:Destroy()
	end

	previous_rpl = #child_table.plr_folder.childs
	for _,v in pairs(child_table.plr_folder.childs) do
		if not players:GetPlayerFromCharacter(v) then continue end
		local text = Instance.new("TextLabel")
		text.Text = v.Name
		text.BackgroundColor3 = falsecolor
		text.Parent = hub._catagories["Players List"]._main_f
	end

end)

hub._runners.runner_npcs_list = rs.RenderStepped:Connect(function(dt)
	rnl += dt
	if (previous_rnl and previous_rnl == #child_table.npc_folder.childs) or rnl < delay_t then return end
	rnl = 0

	for _,v in pairs(hub._catagories["NPCs List"]._main_f:GetChildren()) do
		if not v:IsA("TextLabel") then continue end
		v:Destroy()
	end

	previous_rnl = #child_table.npc_folder.childs
	for _,v in pairs(child_table.npc_folder.childs) do
		local text = Instance.new("TextLabel")
		text.Text = v.Name
		text.BackgroundColor3 = falsecolor
		text.Parent = hub._catagories["NPCs List"]._main_f
	end
end)

hub._runners.runner_input = uis.InputBegan:Connect(function(input, gpe)
	if gpe then return end

	local keyCode
	local inputType

	pcall(function() keyCode = Enum.KeyCode[ChangeKeybindButton._value] end)
	pcall(function() inputType = Enum.UserInputType[ChangeKeybindButton._value] end)

	if (keyCode and input.KeyCode == keyCode) or (inputType and input.UserInputType == inputType) then
		hub._enable = not hub._enable
		targetenemy = nil
		radius.BackgroundColor3 = if hub._enable then Color3.fromRGB(255, 255, 0) else falsecolor
	elseif input.KeyCode == Enum.KeyCode.KeypadPlus then
		hub._screen.Enabled = not hub._screen.Enabled
		extrascreen.Enabled = not extrascreen.Enabled
	end
end)

