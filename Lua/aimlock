local function make_detect_function()
	if child_table.plr_folder.detect_function then
		if typeof(child_table.plr_folder.detect_function) == "table" then
			for _,v in pairs(child_table.plr_folder.detect_function) do
				v:Disconnect()
			end
		else
			child_table.plr_folder.detect_function:Disconnect()
		end
		child_table.plr_folder.detect_function = nil
		child_table.plr_folder.childs = {}
		child_table.plr_folder.childs = paths_module.get_child_folder("plr_folder")
	end
	if child_table.npc_folder.detect_function then
		if typeof(child_table.npc_folder.detect_function) == "table" then
			for _,v in pairs(child_table.npc_folder.detect_function) do
				v:Disconnect()
			end
		else
			child_table.npc_folder.detect_function:Disconnect()
		end
		child_table.npc_folder.detect_function = nil
		child_table.npc_folder.childs = {}
		child_table.npc_folder.childs = paths_module.get_child_folder("npc_folder")
	end

	child_table.plr_folder.detect_function = {}
	child_table.npc_folder.detect_function = {}


	child_table.plr_folder.detect_function[1], child_table.plr_folder.detect_function[2] = paths_module.add_detect_function(child_table.plr_folder.path,
		function(child)
			if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") and players:GetPlayerFromCharacter(child) then
				table.insert(child_table.plr_folder.childs, child)
			end
		end,
		function(child)
			local i = table.find(child_table.plr_folder.childs, child)
			if i then table.remove(child_table.plr_folder.childs, i) end
		end)

	child_table.npc_folder.detect_function[1], child_table.npc_folder.detect_function[2] = paths_module.add_detect_function(child_table.npc_folder.path,
		function(child)
			if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") and not players:GetPlayerFromCharacter(child) then
				table.insert(child_table.npc_folder.childs, child)
			end
		end,
		function(child)
			local i = table.find(child_table.npc_folder.childs, child)
			if i then table.remove(child_table.npc_folder.childs, i) end
		end)
end

plr_folder_path:OnFunction(function(value)
	local text_parts = string.split(plr_folder_path.Text, ".")
	if text_parts[1] == "Workspace" or text_parts[1] == "workspace" then text_parts[1] = workspace end
	local manual_path = paths_module.safeFind(text_parts[1], nil, text_parts[2], text_parts[3], text_parts[4], text_parts[5], text_parts[6])
	if manual_path then
		-- paths_module.child_table.plr_folder.path = manual_path
		child_table.plr_folder.path = manual_path
		warn("found path for Players: ", child_table.plr_folder.path:GetFullName())
		make_detect_function()
	end
	plr_folder_path._button1.Text = child_table.plr_folder.path:GetFullName()
end)

