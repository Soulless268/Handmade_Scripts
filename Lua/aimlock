local jsonAttempts = 0
local function load_setting()
	local readSuccess, out = readfile("NickHub/AIMLOCK.nh", true)
	if readSuccess then
		if out ~= nil and tostring(out):gsub("%s", "") ~= "" then
			local success, response = pcall(function()
				local json = HttpService:JSONDecode(out)

				for key, defaultValue in pairs(configs) do
					local value = json[key]
					if vtype(value, typeof(defaultValue)) then
						configs[key] = value
					else
						configs[key] = defaultValue
					end
				end
			end)
			if not success then
				jsonAttempts = jsonAttempts + 1
				warn("Save Json Error:", response)
				warn("Overwriting Save File")
				writefile("NickHub/AIMLOCK.nh", defaults, true)
				task.wait(1)
				local dReadSuccess, dOut = readfile("NickHub/AIMLOCK.nh", true)
				if dReadSuccess and dOut ~= nil and tostring(dOut):gsub("%s", "") ~= "" then
					load_setting()
				end
			end
		end
	else
		writefile("NickHub/AIMLOCK.nh", defaults, true)
		task.wait(1)
		local dReadSuccess, dOut = readfile("NickHub/AIMLOCK.nh", true)
		if dReadSuccess and dOut ~= nil and tostring(dOut):gsub("%s", "") ~= "" then
			load_setting()
		end
	end

end

