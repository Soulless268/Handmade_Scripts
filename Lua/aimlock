					if adornee:FindFirstChildOfClass("Humanoid") and getRoot(adornee) and character_available() then
						local pos = math.floor((hrp.Position - getRoot(adornee).Position).magnitude)
						local mult = 10^(1 or 0)
						local math = math.floor(adornee:FindFirstChildOfClass('Humanoid').Health * mult + 0.5) / mult
						TextLabel.Text = 'Name: '..isplr.Name..' | Health: '..math..' | Studs: '..pos
