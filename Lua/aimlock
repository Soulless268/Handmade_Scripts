	partbutton.Name = p.Name
	partbutton.Text = p.Name
	partbutton.BackgroundColor3 = falsecolor
	partbutton.Parent = ignore_players_frame
	partbutton.Activated:Connect(function()
		if table.find(ignore_players, p.Name) then
			table.remove(ignore_players, table.find(ignore_players, p.Name))
			partbutton.BackgroundColor3 = falsecolor
			return
		else
			table.insert(ignore_players, p.Name)
			partbutton.BackgroundColor3 = truecolor
		end
	end)
end

for _,p in pairs(players:GetPlayers()) do
	if table.find(ignore_players, p.Name) then return end
	create_plr_b(p)
end

players.PlayerAdded:Connect(function(player)
	if table.find(ignore_players, player.Name) then return end
	create_plr_b(player)
end)

players.PlayerRemoving:Connect(function(player)
	if table.find(ignore_players, player.Name) then
		table.remove(ignore_players, table.find(ignore_players, player.Name))
	end
	local partbutton = ignore_players_frame:FindFirstChild(player.Name)
	if partbutton then
		partbutton:Destroy()
	end
end)
