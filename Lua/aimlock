		new.FillColor = Color3.new(1, 1, 1)
	end

	if EspBoxTypeButton._value then
		new = Instance.new("BillboardGui")
		new.AlwaysOnTop = true
		new.Size = UDim2.new(5,0,7,0)
		local frame = Instance.new("Frame")
