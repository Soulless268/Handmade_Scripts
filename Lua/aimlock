							teamcolor = Color3.new(0, 1, 0)	
						else
							teamcolor = Color3.new(1, 0, 0)
						end
					end
					if not new:IsDescendantOf(real_parent) then espLoopFunc:Disconnect() end
					if new:IsA("BillboardGui") then
						if not new:FindFirstChildOfClass("Frame") then return end
						new:FindFirstChildOfClass("Frame").BackgroundColor3 = teamcolor
					else
						new.FillColor = teamcolor
					end
				else
					espLoopFunc:Disconnect()
				end
			end

			espLoopFunc = rs.RenderStepped:Connect(espLoop)
		end
	end)
	
	local checking
	local c_time = 10
	checking = rs.RenderStepped:Connect(function(dt)
		c_time += dt
		if c_time < 10 then return end
		c_time = 0

		if not adornee:IsDescendantOf(workspace) then
			new:Destroy()
			highlights_store[adornee] = nil
		end

	end)

	adornee.Destroying:Once(function()
		new:Destroy()
		highlights_store[adornee] = nil
	end)
	
