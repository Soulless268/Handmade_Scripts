ShowViewDirectionLineButton.Activated:Connect(function()
	view_direction_line = not view_direction_line
	ShowViewDirectionLineButton.BackgroundColor3 = if view_direction_line then truecolor else falsecolor

	if not cam:FindFirstChild("DirectionLineFolder") then
		directionline_folder = Instance.new("Folder")
		directionline_folder.Name = "DirectionLineFolder"
		directionline_folder.Parent = cam
	else
		directionline_folder = cam:FindFirstChild("DirectionLineFolder")
	end

	local function remove_dir_line(adornee)
		if not directionlines_store[adornee] then return end

		if directionlines_store[adornee].connection then
			directionlines_store[adornee].connection:Disconnect()
		end
		
		if directionlines_store[adornee].beam then
			directionlines_store[adornee].beam.Attachment0:Destroy()
			directionlines_store[adornee].beam.Attachment1:Destroy()
		end

		if directionlines_store[adornee].endPart then
			directionlines_store[adornee].endPart:Destroy()
		end

		directionlines_store[adornee] = nil
	end

	local function add_dir_line(adornee, parent)
		if directionlines_store[adornee] then return end
		local head = adornee:WaitForChild("Head")

		local startAttachment = Instance.new("Attachment")
		startAttachment.Name = "YOOITDIRECTIONLINE!!!START"
		startAttachment.Position = Vector3.new(0, 0, -0.5)
		startAttachment.Parent = parent or head

		local endPart = Instance.new("Part")
		endPart.Name = "YOOITDIRECTIONLINE!!!PART"
		endPart.Size = Vector3.new(0.1, 0.1, 0.1)
		endPart.Transparency = 1
		endPart.CanCollide = false
		endPart.CanQuery = false
		endPart.CanTouch = false
		endPart.Anchored = true
		endPart.Parent = directionline_folder

		local endAttachment = Instance.new("Attachment")
		endAttachment.Parent = endPart

		local beam = Instance.new("Beam")
		beam.Name = "YOOITDIRECTIONLINE!!!"
		beam.Attachment0 = startAttachment
		beam.Attachment1 = endAttachment
		beam.Width0 = 0.08
		beam.Width1 = 0.08
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Parent = endPart

		local connection
		connection = rs.Heartbeat:Connect(function()
			if not adornee or not head.Parent or not startAttachment.Parent or DESTROYED then

				if connection then
					connection:Disconnect()
				end
				
				if beam then
					beam.Attachment0:Destroy()
					beam.Attachment1:Destroy()
				end

				if endPart then
					endPart:Destroy()
				end

				directionlines_store[adornee] = nil
				return
			end

			local direction = head.CFrame.LookVector
			endPart.Position = head.Position + direction * configs.viewlineDistance
		end)

		directionlines_store[adornee] = {endpart = endPart, beam = beam, connection = connection}
	end

	if view_direction_line then
		for _,v in pairs(paths_module.get_child_folder("plr_folder")) do
			if not players:GetPlayerFromCharacter(v) then continue end
			add_dir_line(v)
		end
		runners.runner_direction_line = child_table.plr_folder.path.ChildAdded:Connect(function(child)
			if not players:GetPlayerFromCharacter(child) then return end
			if not directionlines_store[child] then add_dir_line(child) end
		end)
	else
		for _,v in pairs(paths_module.get_child_folder("plr_folder")) do
			remove_dir_line(v)
		end
		if runners.runner_highlight_plr then
			runners.runner_highlight_plr:Disconnect()
		end
	end

end)

local function create_highlight(adornee, parent)
	local isplr = players:GetPlayerFromCharacter(adornee)
	if plr == isplr then return end
	local new = Instance.new("Highlight")
	new.Name = "HighlightYOOitAIMHIGHLIGHT"
	new.FillTransparency = .9
	new.FillColor = Color3.new(1, 1, 1)
	new.Adornee = adornee
	new.Parent = parent or highlight_folder
	highlights_store[adornee] = new

	task.spawn(function()
		if isplr and not adornee:FindFirstChild('Head') then
			repeat task.wait(.1) until adornee:FindFirstChild('Head')
		end
		if isplr and adornee:FindFirstChild("Head") and highlights_store[adornee] then
			local BillboardGui = Instance.new("BillboardGui")
			local TextLabel = Instance.new("TextLabel")
			BillboardGui.Adornee = adornee.Head
			BillboardGui.Name = isplr.Name
			BillboardGui.Parent = new
			BillboardGui.Size = UDim2.new(0, 100, 0, 150)
			BillboardGui.StudsOffset = Vector3.new(0, 1, 0)
			BillboardGui.AlwaysOnTop = true
			TextLabel.Parent = BillboardGui
			TextLabel.BackgroundTransparency = 1
			TextLabel.Position = UDim2.new(0, 0, 0, -50)
			TextLabel.Size = UDim2.new(0, 100, 0, 100)
			TextLabel.Font = Enum.Font.SourceSansSemibold
			TextLabel.TextSize = 20
			TextLabel.TextColor3 = Color3.new(1, 1, 1)
			TextLabel.TextStrokeTransparency = 0
			TextLabel.TextYAlignment = Enum.TextYAlignment.Bottom
			TextLabel.Text = 'Name: '..isplr.Name
			TextLabel.ZIndex = 10

			local espLoopFunc

			local function espLoop()
				if highlights_store[adornee] then
					if adornee:FindFirstChildOfClass("Humanoid") and getRoot(adornee) and character_available() then
						local pos = math.floor((hrp.Position - getRoot(adornee).Position).magnitude)
						local mult = 10^(1 or 0)
						local math = math.floor(adornee:FindFirstChildOfClass('Humanoid').Health * mult + 0.5) / mult
						TextLabel.Text = 'Name: '..isplr.Name..' | Health: '..math..' | Studs: '..pos
					end
				else
					espLoopFunc:Disconnect()
				end
			end

			espLoopFunc = rs.RenderStepped:Connect(espLoop)
		end
	end)
	
	adornee.Destroying:Once(function()
		new:Destroy()
		highlights_store[adornee] = nil
	end)
	
end

local function clear_nil_highlight()
	for i,v in pairs(highlights_store) do
		if not v.Adornee then v:Destroy() else continue end
	end
end

