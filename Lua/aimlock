local function clear_nil_highlight()
	for i,v in pairs(highlights_store) do
		if not v.Adornee then v:Destroy() else continue end
	end
end

ESPPlayer:OnFunction(function(value)
	logs("highlight in player folder")

	local hl = if highlights_store[child_table.plr_folder.path] then highlights_store[child_table.plr_folder.path] else nil
	clear_nil_highlight()

	if value then
		if child_table.plr_folder.path:IsA("Folder") or child_table.plr_folder.path == workspace then
			for _,v in pairs(paths_module.get_child_folder("plr_folder")) do
				if not players:GetPlayerFromCharacter(v) then continue end
				create_highlight(v)
			end
			hub._runners.runner_highlight_plr = child_table.plr_folder.path.ChildAdded:Connect(function(child)
				if not highlights_store[child] then create_highlight(child) end
			end)
		else
			if hl then return end
			create_highlight(child_table.plr_folder.path)
		end
	else
		if hl then
			hl:Destroy()
		else
			for _,c in pairs(paths_module.get_child_folder("plr_folder")) do
				if highlights_store[c] then highlights_store[c]:Destroy() end
			end
			if hub._runners.runner_highlight_plr then
				hub._runners.runner_highlight_plr:Disconnect()
			end
		end
	end
end)

