	local current_path = nil
	local highest = 0
	local tbl = {}
	for _,v in pairs(players:GetPlayers()) do
		local c = v.Character
		if not c then continue end
		if not c.Parent then continue end
		if not tbl[c.Parent] then tbl[c.Parent] = 0 end
		tbl[c.Parent] += 1
	end

	for i,v in pairs(tbl) do
		if v >= highest then
			highest = v
			current_path = i
		end
	end

	if current_path then
		module.child_table.plr_folder.path = current_path
		module.child_table.plr_folder.found = true
	end

end

