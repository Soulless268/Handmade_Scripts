function missing(t, f, fallback)
	if type(f) == t then return f end
	return fallback
end

module.safeFind = function(root, pattern, ...)
	local paths = {...}
	local current = root
	for index, name in ipairs(paths) do
		if not current then return end

		for _,v in pairs(current:GetChildren()) do
			if v.Name ~= name then continue end
			local temp_current = v
			local child = temp_current:GetChildren()
			local count = 0

			if index == #paths then
				if pattern then
					if pattern.must_have then
						for _,v in pairs(child) do
							if table.find(pattern.must_have, v.Name) then
								count += 1
							end
						end
						if count == #child then
							current = temp_current
							break
						end
					end
				else
					current = temp_current
					break
				end

			else
				current = temp_current
			end

		end
	end

	return current
end

