task.spawn(function()
	while enable do
		task.wait()
		if not auto_fish then continue end

        local our_fishing_rod, tip = nil, nil

        for _,child in plr.Character:FindFirstChild("Tool_Accessories"):GetChildren() do
            for _,v in child:GetDescendants() do
                if v.Name == "Tip" then
                    print(v)
                    our_fishing_rod = child
                    tip = v
                    break
                end
            end
        end

        if not our_fishing_rod then continue end

        task.wait(.5)

        local found = false
        for _,v in workspace.Debree:GetChildren() do
            if not v:FindFirstChild("FishingLine") then continue end
            if v:FindFirstChild("FishingLine").Attachment0 == tip then
                found = true
            else
                continue
            end
        end

        local fishing_frame = plr.PlayerGui.Misc:FindFirstChild("CanvasGroup")

		if fishing_frame then
			local bar = plr.PlayerGui.Misc.CanvasGroup.Frame.Bar
			local tracker = plr.PlayerGui.Misc.CanvasGroup.Frame.tracker
			repeat
				local center1 = bar.AbsolutePosition + bar.AbsoluteSize / 2
				local center2 = tracker.AbsolutePosition + tracker.AbsoluteSize / 2

				if center1.Y-center2.Y < 0 then
					mouse1release()
				else
					mouse1press()
				end

			until not fishing_frame:IsDescendantOf(plr.PlayerGui)
            task.wait(1)
            press_key("T")
		elseif not found then 
            task.wait(1)
			mouse1press()
            task.wait(.1)
            mouse1release()
            task.wait(.1)
		end

	end
end)

auto_fish_button.Activated:Connect(function()
    auto_fish = not auto_fish
    auto_fish_button.BackgroundColor3 = if auto_fish then truecolor else falsecolor
end)

destroybutton.MouseButton1Down:Connect(function()
	enable = false
    DESTROYED = true

    for i,v in pairs(runners) do
		if v then
			v:Disconnect()
		end
	end
	
	screen:Destroy()
end)

runners.proximity = ProximityPrompts_Screen.ChildAdded:Connect(function(child)
    if child:IsDescendantOf(ProximityPrompts_Screen) then
        if child:IsA("BillboardGui") then
            if child.Adornee:FindFirstChildOfClass("ProximityPrompt").HoldDuration ~= hold_proximity_time then
                child.Adornee:FindFirstChildOfClass("ProximityPrompt").HoldDuration = hold_proximity_time
            end
        end
    end
end)

runners.runner_input = uis.InputBegan:Connect(function(input, GPE)
	if GPE then return end

	if input.KeyCode == Enum.KeyCode.KeypadPlus then
		screen.Enabled = not screen.Enabled
	end
end)