runners.runner_daggerQte = plr.PlayerGui:WaitForChild("Combat").DaggerQTE.ChildAdded:Connect(function(child)
	if not enable then return end
	if child.Name ~= "ActiveRing" then return end

	local function rot_transform(rot)
        return rot % 360
    end

	local function tranform_step(rot)
		return 360 - rot
	end

    local needle = plr.PlayerGui.Combat.DaggerQTE.Indicator
	local rings = child

	local runner
	local done = {}
	task.wait()
	runner = rs.RenderStepped:Connect(function()
		for _,v in pairs(rings:GetChildren()) do
			if v.Name == "AttackTemplate" then continue end
			if done[v] then continue end

			local peak_rot = tranform_step(v.Rotation)
			local lowest = peak_rot + -10
			local highest = peak_rot + 10
			
			if (rot_transform(rings.Rotation) >= lowest and rot_transform(rings.Rotation) <= highest) then
				done[v] = true
				v.Visible = false
				press_key("Space")
			end
		end
		if not plr.PlayerGui.Combat.DaggerQTE.Visible or not enable then
			if runner then runner:Disconnect(); runner = nil end
			done = nil
		end
	end)
end)

