end

local function autoClickImage(obj, show_hb)
    local center = obj.AbsolutePosition + obj.AbsoluteSize / 2
    local inset = gs:GetGuiInset()

    local mouseX = center.X + inset.X
    local mouseY = center.Y + inset.Y

    if show_hb then
        local hitbox = Instance.new("Frame")
        hitbox.Size = UDim2.fromOffset(10, 10)
        hitbox.AnchorPoint = Vector2.new(.5,.5)
        hitbox.Position = UDim2.fromOffset(center.X, center.Y)
        hitbox.Parent = screen
        game.Debris:AddItem(hitbox, 5)
    end

    vim:SendMouseButtonEvent(mouseX, mouseY, 0, true, game, 1)
    task.wait()
    vim:SendMouseButtonEvent(mouseX, mouseY, 0, false, game, 1)
end

local function press_key(keycode)
	task.wait()
	vim:SendKeyEvent(true, Enum.KeyCode[keycode], false, game)
	task.wait(.01)
	vim:SendKeyEvent(false, Enum.KeyCode[keycode], false, game)
	task.wait(.05)
end

local function press_enter()
	task.wait()
	vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
	task.wait(.01)
	vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
	task.wait(.05)
end

