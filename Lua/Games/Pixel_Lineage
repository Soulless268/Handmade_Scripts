hub._runners.runner_autoPlay = rs.RenderStepped:Connect(function()
    if not AutoPlay._value then return end

    local ready = plr.PlayerGui.PBTravelScreen.Sky:FindFirstChild("PixelButton")
    local pixel_command = plr.PlayerGui.PlatformBattlesCinematic.PixelBattle:FindFirstChild("PixelCommands")
    local run_map = plr.PlayerGui.PlatformBattlesRunMap.RunMap
    local results = plr.PlayerGui.PlatformBattlesCinematic.PixelBattle:FindFirstChild("Results")

    if ready then
        if not ready.Visible then return end
        autoClickImage(ready)
        ready.Visible = false
    end

    if pixel_command.Commands.Visible then
        local attack = pixel_command.Commands.Attack
        local foes = pixel_command.Party.FoesPage.ScrollingFrame
        autoClickImage(attack)

        task.wait(.1)

        if #foes:GetChildren() > 1 then
            press_key("Space")
        end
    end

    if run_map:FindFirstChild("Popup") then
        autoClickImage(run_map:FindFirstChild("Popup").Window.PlayAgain)
    elseif run_map:FindFirstChild("Cards") then

        if run_map:FindFirstChild("Cards"):FindFirstChild("Event") then
            if #run_map:FindFirstChild("Cards"):FindFirstChild("Event").Body:GetChildren() < 1 then return end
            autoClickImage(run_map:FindFirstChild("Cards").Event.Body:GetChildren()[math.random(1, #run_map:FindFirstChild("Cards").Event.Body:GetChildren())])
            
            for _,v in run_map:FindFirstChild("Cards"):FindFirstChild("Event"):GetChildren() do
                if not v:FindFirstChildOfClass("TextButton") then continue end
                autoClickImage(v:FindFirstChildOfClass("TextButton"))
                break
            end
            return
        end

        local options = {}
        for _,v in run_map:FindFirstChild("Cards"):GetChildren() do
            if not v:IsA("TextButton") then continue end
            if not v.Visible then continue end
            table.insert(options, v)
        end
        if not next(options) then return end
        autoClickImage(options[math.random(1, #options)])
        options = nil
    end

    if results then
        autoClickImage(results.Continue)
    end

    if plr.PlayerGui.PlatformBattlesCinematic.PixelBattle.Stage.Effects:FindFirstChild("BossChest") then
        press_key("Space")
    end

    if plr.PlayerGui.PlatformBattlesCinematic.PixelBattle:FindFirstChild("ChestShade") then
        autoClickImage(plr.PlayerGui.PlatformBattlesCinematic.PixelBattle:FindFirstChild("ChestShade").LootPanel.PixelButton)
    end

end)

hub._runners.runner_Qte = plr.PlayerGui.PlatformBattlesCinematic.PixelBattle.PixelQTE.Panel.Area.ChildAdded:Connect(function(child)
    if not AutoQTE._value then return end
    if child.Name ~= "Track" then return end

    local needle = child.Needle
    local target = child.Perfect

    local center1 = needle.AbsolutePosition + needle.AbsoluteSize / 2
    local center2 = target.AbsolutePosition + target.AbsoluteSize / 2

    local runner
    runner = needle:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
        if not AutoQTE._value then if runner then runner:Disconnect() return end end

        center1 = needle.AbsolutePosition + needle.AbsoluteSize / 2
        center2 = target.AbsolutePosition + target.AbsoluteSize / 2

        if math.abs(center1.X - center2.X) <= target.AbsoluteSize.X/2 then
            press_key("Space")
            if runner then runner:Disconnect() end
            task.delay(10, function()
                if runner then runner:Disconnect() end
                runner = nil
            end)
        end
    end)

end)

hub._runners.runner_MageQte = plr.PlayerGui.PlatformBattlesCinematic.PixelBattle.PixelQTE.Panel.Area.ChildAdded:Connect(function(child)
    if not AutoMage._value then return end
    if child.Name == "Frame" and child.ZIndex == 128 and child:FindFirstChild("UIStroke") then

        local runner
        runner = child:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            if not AutoMage._value then if runner then runner:Disconnect() return end end

            if child.UIStroke.Color ~= Color3.fromRGB(255,255,255) then
                press_key("Space")
                if runner then runner:Disconnect() end
                task.delay(10, function()
                    if runner then runner:Disconnect() end
                    runner = nil
                end)
            end
        end)
    end
end)

